# CareerAI Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Application ────────────────────────────────────────────────────────────
APP_NAME=CareerAI
ENV=development
DEBUG=false
FRONTEND_URL=http://localhost:5173

# ── Database (PostgreSQL) ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://careerai:yourpassword@localhost:5432/careerai

# ── JWT Authentication ─────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-generate-with-secrets-token-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

# ── Google OAuth 2.0 ───────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Email ──────────────────────────────────────────────────────────────────
# Provider: smtp | resend
EMAIL_PROVIDER=smtp

# SMTP (e.g. Gmail with App Password, or any SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@careerai.app

# OR Resend (https://resend.com)
RESEND_API_KEY=

# ── LLM / AI ───────────────────────────────────────────────────────────────
# Provider: openai | anthropic
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60

# Embeddings (OpenAI)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ── Redis (rate limiting, session cache) ───────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── File Storage ───────────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage/resumes
MAX_UPLOAD_BYTES=10485760

# Production S3-compatible storage
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT_URL=

# ── Rate Limits ────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_OTP=3/minute
RATE_LIMIT_UPLOAD=5/minute
RATE_LIMIT_ANALYSIS=3/minute
RATE_LIMIT_AI=10/hour
